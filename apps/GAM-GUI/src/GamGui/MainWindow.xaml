<Window x:Class="GamGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAM Workbench"
        Width="1340" Height="880" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        Foreground="{StaticResource InkBrush}"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource NavBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="26,22,16,18">
                    <TextBlock Text="GAM Workbench" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GamVersionText" Text="Looking for GAM…" Foreground="{StaticResource StripMutedBrush}"
                               FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="DomainText" Margin="26,10,16,16" FontSize="12"
                           Foreground="{StaticResource StripMutedBrush}" TextWrapping="Wrap"/>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Nav_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Current screen -->
        <ContentControl x:Name="Host" Grid.Column="1" Grid.Row="0" Focusable="False"/>

        <!-- Command strip: the exact GAM line behind whatever just happened -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource StripBrush}" Padding="16,7,12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StripStatus" Foreground="{StaticResource StripMutedBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <Button x:Name="StripCopy" Content="Copy" Style="{StaticResource StripButton}" Click="StripCopy_Click"
                            ToolTip="Copy this command line"/>
                    <Button Content="History" Style="{StaticResource StripButton}" Click="StripHistory_Click"
                            ToolTip="Commands run in this session"/>
                </StackPanel>
                <TextBlock Text="›" Foreground="#5FC2B2" FontFamily="{StaticResource MonoFont}" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="StripCommand" Text="Commands appear here as they run."
                           Foreground="{StaticResource StripTextBrush}" FontFamily="{StaticResource MonoFont}"
                           FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
