<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Change to net9.0-windows to build with .NET 9 (also update GamGui.Core to net9.0). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GamGui</RootNamespace>
    <AssemblyName>GamWorkbench</AssemblyName>
    <Product>GAM Workbench</Product>
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allows building on non-Windows machines; the app itself only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamGui.Core\GamGui.Core.csproj" />
  </ItemGroup>

</Project>
