<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GamGui.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fallback copy of GAM's command syntax reference (used when gam.exe's folder has none). -->
    <EmbeddedResource Include="GamCommands.txt" LogicalName="GamGui.Core.GamCommands.txt" />
    <None Include="GAM-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
